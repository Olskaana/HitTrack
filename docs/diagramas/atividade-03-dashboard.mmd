flowchart TB
  open["Analista abre uma tela<br/>ou seleciona filtros"]
  request["Frontend solicita luta,<br/>histórico ou agregados"]
  query["API consulta e filtra dados<br/>persistidos"]
  metrics["Calcula comparações,<br/>linhas do tempo e cobertura"]
  render["Frontend exibe gráficos,<br/>tabelas e histórico"]
  closed["Luta encerrada:<br/>mostra sugestões pós-luta"]
  live["Luta em andamento:<br/>mostra estado sem sugestões"]
  open --> request
  request --> query
  query --> metrics
  metrics --> render
  render -->|"encerrada"| closed
  render -->|"em andamento"| live
